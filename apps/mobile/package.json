{
  "name": "omp-client-mobile",
  "version": "0.1.0",
  "description": "OMP Client mobile shell (Tauri 2 + Svelte + TypeScript)",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "prettier --write \"src/**/*.{ts,svelte,css}\" \"tests/**/*.ts\" \"*.{js,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,svelte,css}\" \"tests/**/*.ts\" \"*.{js,json}\"",
    "tauri": "tauri",
    "test": "node --test tests/*.test.ts"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "3.0.10",
    "@sveltejs/kit": "2.65.1",
    "@sveltejs/vite-plugin-svelte": "7.1.2",
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "24.19.2",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "svelte": "5.56.3",
    "svelte-check": "4.6.0",
    "typescript": "6.0.3",
    "vite": "8.0.16"
  }
}
